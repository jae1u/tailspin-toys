---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import GameFilters from '../components/GameFilters.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <GameFilters categories={categories} publishers={publishers} />
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="no-filter-results">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filters = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const noResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');
  const resultStatus = document.querySelector<HTMLElement>('[data-testid="filter-results"]');
  const categoryFilter = filters?.querySelector<HTMLSelectElement>('[data-testid="category-filter"]');
  const publisherFilter = filters?.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');

  if (filters && gamesGrid && noResults && resultStatus && categoryFilter && publisherFilter) {
    const cards = Array.from(gamesGrid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

    const updateResults = (): void => {
      const selectedCategories = new Set(
        Array.from(categoryFilter.selectedOptions, (option) => option.value),
      );
      const selectedPublisher = publisherFilter.value;
      let visibleCount = 0;

      for (const card of cards) {
        const matchesCategory =
          selectedCategories.size === 0 ||
          selectedCategories.has(card.dataset.categoryId ?? '');
        const matchesPublisher =
          selectedPublisher === '' || card.dataset.publisherId === selectedPublisher;
        const isVisible = matchesCategory && matchesPublisher;

        card.classList.toggle('hidden', !isVisible);
        if (isVisible) visibleCount += 1;
      }

      gamesGrid.classList.toggle('hidden', visibleCount === 0);
      noResults.classList.toggle('hidden', visibleCount !== 0);
      resultStatus.textContent =
        selectedCategories.size === 0 && selectedPublisher === ''
          ? 'Showing all games'
          : `${visibleCount} ${visibleCount === 1 ? 'game' : 'games'} shown`;
    };

    filters.addEventListener('change', updateResults);
    filters.addEventListener('reset', () => requestAnimationFrame(updateResults));
  }
</script>
